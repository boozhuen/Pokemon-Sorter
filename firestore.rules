rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Participant submissions.
    match /participants/{participantId} {
      allow create: if true;
      allow read: if true;

      // Needed for admin rebalancing.
      // WARNING: This is intentionally simple for an internal event.
      // Anyone who knows the site can technically edit participant records.
      allow update: if true;
      allow delete: if false;
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
