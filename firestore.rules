rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // ==================================================
    // PARTICIPANTS
    // ==================================================

    match /participants/{participantId} {

      // Allow colleagues to submit themselves
      allow create: if true;


      // Needed so the website/admin page can read teams
      allow read: if true;


      // Needed for admin rebalancing
      allow update: if true;


      // Needed for Remove and Clear All
      allow delete: if true;

    }


    // ==================================================
    // WEBSITE CONFIGURATION
    // ==================================================

    match /config/{document=**} {

      // Participant page needs to know team count
      allow read: if true;


      // Admin page can change team count
      allow write: if true;

    }

  }

}
